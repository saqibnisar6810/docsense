# AI (at least one). Groq is free and fast: https://console.groq.com/keys
GROQ_API_KEY=
# Optional fallback, and needed for scanned PDFs sent straight to the REST API
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional model overrides
# GROQ_TEXT_MODEL=openai/gpt-oss-120b
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# GEMINI_MODEL=gemini-3.8-flash

# Storage. Leave empty to run in memory (local demo mode).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Protects the daily cleanup job (Vercel sends it automatically)
CRON_SECRET=

# Demo limits per visitor per hour
# RATE_LIMIT_PER_HOUR=20
# API_RATE_LIMIT_PER_HOUR=10

# Offline mode for local tests: returns the bundled sample answers instead of calling an AI
# EXTRACT_MOCK=1
